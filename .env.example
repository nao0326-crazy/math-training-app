# 公開状態フラグ。trueにすると通常画面ではなくメンテナンス画面を表示する。
VITE_MAINTENANCE_MODE=false

# 既定の管理者コードに加えて別コードも許可する場合は、平文ではなくSHA-256ハッシュを設定する。
# 未設定の場合はアプリ内の既定コードだけを使用する。これはクライアント側の簡易ゲートです。
# ハッシュの生成方法:
#   npm run admin:hash -- "任意のパスワード"
# このゲートは認証用ではなく「通常ユーザーから選択機能を隠す」ためのもの。
VITE_ADMIN_SALT=
VITE_ADMIN_PASSWORD_HASH=

# ブラウザーに公開するSupabase接続情報のみ。
# anon/publishable keyは公開情報ですが、service-role keyなどの秘密情報はここへ書かないこと。
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
